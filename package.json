{
  "name": "orderflow",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3344\"",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test run",
    "test:features": "playwright test --config=test/features/playwright.config.ts",
    "test:features:ui": "playwright test --config=test/features/playwright.config.ts --ui",
    "test:smoke": "playwright test --config=test/smoke/playwright.config.ts",
    "test:smoke:ui": "playwright test --config=test/smoke/playwright.config.ts --ui",
    "deploy": "vp run build && vp exec wrangler deploy",
    "start": "node --import ./instrument.server.mjs dist/server/index.js",
    "prepare": "vp config",
    "db:gentypes": "supabase gen types typescript --local > src/lib/database.types.ts"
  },

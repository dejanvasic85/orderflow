{
  "name": "orderflow",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3344\"",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test run",
    "test:features": "playwright test --config=test/features/playwright.config.ts",
    "test:features:ui": "playwright test --config=test/features/playwright.config.ts --ui",
    "test:smoke": "playwright test --config=test/smoke/playwright.config.ts",
    "test:smoke:ui": "playwright test --config=test/smoke/playwright.config.ts --ui",
    "deploy": "vp run build && vp exec wrangler deploy",
    "start": "node --import ./instrument.server.mjs dist/server/index.js",
    "prepare": "vp config",
    "db:gentypes": "supabase gen types typescript --local > src/lib/database.types.ts"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.54.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@sentry/cloudflare": "10.71.0",
    "@sentry/core": "10.71.0",
    "@sentry/tanstackstart-react": "10.71.0",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.102.6",
    "@tanstack/react-query-devtools": "5.102.6",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.49",
    "@tanstack/router-plugin": "1.168.35",
    "aws4fetch": "1.0.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dotenv-cli": "11.0.0",
    "framer-motion": "13.1.1",
    "lucide-react": "1.34.0",
    "playwright": "1.62.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "20.1.1",
    "react-easy-crop": "6.2.3",
    "react-email": "6.9.3",
    "recharts": "3.10.1",
    "shadcn": "4.19.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.62.1",
    "@sentry/cli": "3.6.2",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "17.4.2",
    "jsdom": "30.0.1",
    "supabase": "2.116.0",
    "tsx": "4.23.12",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",

    "vite-plus": "0.3.0",
    "wrangler": "4.126.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0"
}
